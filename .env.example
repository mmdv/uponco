APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Left empty on purpose: Laravel then marks the session and "remember me"
# cookies Secure whenever the request itself is HTTPS, so production is
# protected without breaking local http development. Setting it to a literal
# `false` (the old value) disabled the flag even in production, letting the
# session cookie travel in the clear.
SESSION_SECURE_COOKIE=null

# How long a password confirmation stays valid, in seconds. It gates disabling
# 2FA and deleting passkeys, so it is kept well below Laravel's 3-hour default.
AUTH_PASSWORD_TIMEOUT=1800

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Product analytics. Leave the key empty to disable tracking entirely.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST="https://eu.i.posthog.com"

GOOGLE_PLACES_API_KEY=

# Web Push (PWA notifications). Generate the key pair with `php artisan webpush:vapid`.
VAPID_SUBJECT="mailto:support@uponco.com"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
